# 客户端构建内嵌赞助商预置，不读取根目录的 .env 文件；路径相对于项目根目录
VITE_DEFAULT_API_URL=./sponsor-presets.json
# 客户端默认使用内置字体，并从安装包自带的字体文件加载；自行构建时可在 src-tauri/.env.local 中覆盖
VITE_DEFAULT_UI_FONT=builtin
VITE_DEFAULT_MONO_FONT=builtin
VITE_BUILTIN_FONT_SOURCE=local
# 客户端分享链接使用的网页版地址；未设置时分享链接改用 deep link
VITE_WEB_APP_URL=https://gpt-image-2.88lin.eu.org/
